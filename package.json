{
  "author": "RedKubes",
  "bugs": {
    "url": "https://github.com/redkubes/otomi-api/issues"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.3",
    "@casl/ability": "7.0.1",
    "@kubernetes/client-node": "1.4.0",
    "@linode/api-v4": "0.158.0",
    "@linode/kubeseal-encrypt": "^1.0.1",
    "@types/json-schema": "7.0.15",
    "@types/jsonwebtoken": "9.0.10",
    "async-retry": "^1.3.3",
    "axios": "1.20.0",
    "clean-deep": "3.4.0",
    "cors": "2.8.6",
    "debug": "4.4.3",
    "deep-diff": "1.0.2",
    "envalid": "8.2.0",
    "express": "5.2.1",
    "express-openapi-validator": "5.6.2",
    "express-rate-limit": "^8.7.0",
    "fs-extra": "11.4.1",
    "generate-password": "1.7.1",
    "glob": "13.0.6",
    "jose": "^6.2.12",
    "jsonpath": "1.3.0",
    "jsonwebtoken": "9.0.3",
    "jwt-decode": "4.0.0",
    "lightship": "6.7.2",
    "lodash": "4.18.1",
    "morgan": "1.12.1",
    "semver": "^7.8.5",
    "simple-git": "4.0.2",
    "socket.io": "4.8.4",
    "swagger-ui-express": "5.0.1",
    "ts-custom-error": "3.3.1",
    "uuid": "14.0.2",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "description": "The brain of the Otomi Container Platform. Handling console input and talking to core, it knows what to do.",
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@eslint/compat": "2.1.1",
    "@redocly/openapi-cli": "1.0.0-beta.95",
    "@types/async-retry": "^1.4.8",
    "@types/debug": "^4.1.13",
    "@types/expect": "24.3.2",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "30.0.0",
    "@types/jsonpath": "0.2.4",
    "@types/lodash": "4.17.25",
    "@types/node": "24.12.2",
    "@types/semver": "^7.8.0",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "babel-jest": "30.5.2",
    "copyfiles": "2.4.1",
    "cspell": "10.3.4",
    "dotenv": "18.0.3",
    "eslint": "10.11.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-mock-extended": "4.0.1",
    "lint-staged": "17.5.1",
    "nock": "14.0.17",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "npm-watch": "0.13.0",
    "openapi-schema-validator": "12.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "proxyquire": "2.1.3",
    "supertest": "7.3.0",
    "supports-color": "11.0.0",
    "swagger-node-codegen": "1.6.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "1.9.5",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "watch": "1.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "engineStrict": true,
  "homepage": "https://github.com/redkubes/otomi-api#readme",
  "license": "ISC",
  "overrides": {
    "@babel/core": "$@babel/core"
  },
  "lint-staged": {
    "*.{js,ts,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "main": "dist/src/app.js",
  "name": "@redkubes/otomi-api",
  "publishConfig": {
    "private": true,
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redkubes/otomi-api.git"
  },
  "scripts": {
    "build": "npm run clean && npm run build:models && tsc && tsc-alias --dir dist -v && copyup --error src/generated-schema.json src/values-schema.yaml src/ttyManifests/*.yaml src/ttyManifests/adminTtyManifests/*.yaml dist/src && copyup --error ./src/license/license.pem ./dist/src",
    "build:models": "npm run build:spec && openapi-typescript src/generated-schema.json -o src/generated-schema.ts --default-non-nullable false",
    "build:spec": "tsx src/build-spec.ts",
    "clean": "rm -rf dist >/dev/null",
    "predev": "npm run schema:sync",
    "dev": "run-p watch dev:node",
    "dev:node": "tsx watch --env-file=.env --inspect=4321 src/app.ts",
    "lint": "run-p types lint:ts",
    "lint:ts": "eslint --ext ts .",
    "lint:fix": "eslint --ext ts --fix .",
    "lint-staged": "lint-staged",
    "postinstall": "npm run build:models",
    "pre-release:client": "npm version prerelease --preid rc --no-commit-hooks --no-git-tag-version && bin/release-client.sh",
    "schema:sync": "APL_CORE_PATH=${APL_CORE_PATH:-../apl-core} && cp \"$APL_CORE_PATH/values-schema.yaml\" src/values-schema.yaml && echo \"Schema synced from $APL_CORE_PATH\"",
    "release:client": "bin/release-client.sh",
    "start": "node dist/src/app.js",
    "test": "npm run build:models && jest",
    "test:pattern": "npm run build:models && jest --forceExit",
    "types": "tsc --noEmit",
    "prepare": "husky install",
    "watch": "npm-watch",
    "license:sign": "tsx src/license.ts"
  },
  "version": "5.1.0",
  "watch": {
    "build:models": {
      "patterns": [
        "src/openapi"
      ],
      "extensions": "yaml",
      "runOnChangeOnly": true
    }
  }
}
